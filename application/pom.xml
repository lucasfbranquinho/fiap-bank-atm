        'infrastructure' (JDBC/SQLite) nem 'presentation' (Swing).
    -->
    <dependencies>
        <dependency>
            <groupId>com.fiap.bank</groupId>
            <artifactId>domain</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
        </dependency>
    </dependencies>
</project>
